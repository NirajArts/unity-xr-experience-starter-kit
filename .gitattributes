* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
# Unity serializes empty YAML values with a space after the colon.
*.meta whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.wav binary
*.png binary
